{
  "name": "smartscreen-privacy-suite",
  "version": "1.0.0",
  "description": "Privacy screen overlay desktop app",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:py": "python -m pytest backend/tests -q",
    "test:all": "npm test && npm run test:py",
    "test:state": "node tests/privacy_state.test.js",
    "health": "node scripts/runtime_health.js",
    "test:e2e": "playwright test -c tests/e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "electron": "44.5.1",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "com.smartscreen.privacy",
    "productName": "SmartScreen Privacy Suite",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*"
    ],
    "extraResources": [
      {
        "from": "backend/dist/",
        "to": "backend/dist/",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "assets/",
        "to": "assets/",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "models/",
        "to": "models/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "koffi": "^3.3.3"
  }
}
