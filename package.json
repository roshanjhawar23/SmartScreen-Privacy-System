{
  "name": "smartscreen-privacy-suite",
  "version": "1.0.0",
  "description": "Local-first webcam privacy screen for Windows",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "build": "npm run build:ai && electron-builder",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:py": "python -m pytest backend/tests -q",
    "test:all": "npm test && npm run test:py",
    "test:state": "node tests/privacy_state.test.js",
    "health": "node scripts/runtime_health.js",
    "test:e2e": "playwright test -c tests/e2e",
    "build:ai": "python -m PyInstaller --noconfirm --clean --distpath backend/dist --workpath backend/build backend/smartscreen_ai.spec",
    "build:installer": "electron-builder"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "electron": "44.5.1",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "com.smartscreen.privacy",
    "productName": "SmartScreen Privacy Suite",
    "copyright": "Copyright (c) 2026 Roshan Jhawar",
    "directories": {
      "output": "dist"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "package.json",
      "electron/**/*.js",
      "frontend/**/*.{html,css,js}",
      "config/settings.json",
      "config/policies.json",
      "!**/*.backup*",
      "!**/*.{log,enc,jpg,jpeg,png,bmp}",
      "!**/[Ii]ntruder_[Ll]ogs/**"
    ],
    "extraResources": [
      {
        "from": "backend/dist/smartscreen_ai/",
        "to": "backend/smartscreen_ai/",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "assets/",
        "to": "assets/",
        "filter": [
          "icon.ico",
          "icon.png",
          "icon.svg",
          "icon-*.png",
          "icons/*.png"
        ]
      },
      {
        "from": "models/",
        "to": "models/",
        "filter": [
          "*.onnx"
        ]
      },
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "THIRD_PARTY_NOTICES.txt",
        "to": "THIRD_PARTY_NOTICES.txt"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "license": "LICENSE",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SmartScreen Privacy Suite"
    },
    "afterPack": "scripts/after_pack.js",
    "publish": null
  },
  "dependencies": {
    "koffi": "^3.3.3"
  },
  "license": "MIT",
  "author": "Roshan Jhawar"
}
